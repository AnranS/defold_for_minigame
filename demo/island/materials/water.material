}
vertex_constants {
  name: "sun_color"
  type: CONSTANT_TYPE_USER
  value { x: 1.0 y: 0.95 z: 0.85 w: 1.0 }
}
vertex_constants {
  name: "ambient"
  type: CONSTANT_TYPE_USER
  value { x: 0.45 y: 0.5 z: 0.6 w: 1.0 }
}
vertex_constants {
  name: "fog"
  type: CONSTANT_TYPE_USER
  value { x: 60.0 y: 0.01 z: 0.0 w: 1.0 }
}
vertex_constants {
  name: "eye"
  type: CONSTANT_TYPE_USER
  value { x: 0.0 y: 30.0 z: 30.0 w: 1.0 }
}
vertex_constants {
  name: "mood"
  type: CONSTANT_TYPE_USER
  value { x: 0.0 y: 0.0 z: 0.0 w: 0.0 }
}
fragment_constants {
  name: "fog_color"
  type: CONSTANT_TYPE_USER
  value { x: 0.75 y: 0.87 z: 0.95 w: 1.0 }
}
fragment_constants {
  name: "grade"
  type: CONSTANT_TYPE_USER
  value { x: 1.0 y: 1.0 z: 1.0 w: 1.0 }
}
fragment_constants {
  name: "fog_params"
  type: CONSTANT_TYPE_USER
  value { x: 60.0 y: 0.01 z: 0.0 w: 0.0 }
}
fragment_constants {
  name: "cam_pos"
  type: CONSTANT_TYPE_USER
