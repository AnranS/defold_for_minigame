name: "water"
tags: "water"
vertex_program: "/materials/water.vp"
fragment_program: "/materials/water.fp"
vertex_space: VERTEX_SPACE_LOCAL
vertex_constants {
  name: "mtx_viewproj"
  type: CONSTANT_TYPE_VIEWPROJ
}
