#version 140

// One vertex format for everything solid on the island.
// color0.a says what a vertex is:
//   0.00 plain          0.25 sways in the wind (leaves, grass, flags)
//   0.60 never snowed on (people, boats)   1.00 glows at night (windows, lamps)

in highp vec4 position;
in mediump vec3 normal;
in mediump vec4 color0;

out mediump vec3 var_color;
out highp vec3 var_world;

uniform vs_uniforms
{
    highp mat4 mtx_viewproj;
    highp mat4 mtx_world;    // where the mesh's game object stands and how it is turned
    mediump vec4 sun_dir;    // xyz towards the sun
    mediump vec4 sun_color;  // rgb
    mediump vec4 ambient;    // rgb
    highp vec4 fog;          // x start, y 1/(end-start), z time, w wind
    highp vec4 eye;          // camera position
    mediump vec4 mood;       // x night 0..1, y snow cover 0..1
};

void main()
{
    highp vec3 p = (mtx_world * vec4(position.xyz, 1.0)).xyz;
    mediump float kind = color0.a;
    mediump float sway = step(0.2, kind) * step(kind, 0.3);
    p.x += sway * sin(fog.z * 1.7 + p.x * 1.3 + p.z * 0.9) * 0.05 * fog.w;
    p.z += sway * cos(fog.z * 1.3 + p.x * 0.7 + p.z * 1.1) * 0.03 * fog.w;

    mediump vec3 n = normalize((mtx_world * vec4(normal, 0.0)).xyz);
    mediump float glow = step(0.9, kind);
    mediump float snowable = 1.0 - step(0.55, kind);
    mediump vec3 base = mix(color0.rgb, vec3(0.95, 0.97, 1.0), snowable * mood.y * smoothstep(0.55, 0.9, n.y));

    mediump float nl = max(dot(n, sun_dir.xyz), 0.0);
    // Light from the whole sky above and a little bounced back from the ground,
    // so that things have a lit top and a darker underside even out of the sun.
    mediump float hemi = 0.62 + 0.38 * (n.y * 0.5 + 0.5);
    mediump float bounce = max(-n.y, 0.0) * 0.1;
    mediump vec3 lit = base * (ambient.rgb * hemi + sun_color.rgb * (nl * 0.95 + bounce));
    lit = mix(lit, base * 1.5 + vec3(0.3, 0.22, 0.05), glow * mood.x);
    var_color = lit;

    var_world = p + eye.xyz * 0.0;
    gl_Position = mtx_viewproj * vec4(p, 1.0);
}
