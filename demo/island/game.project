[project]
title = PinchAnIsland
version = 0.1.0
dependencies#0 = https://github.com/AnranS/defold_for_minigame/archive/refs/tags/v0.1.0.zip

[bootstrap]
main_collection = /main/main.collectionc
render = /render/island.renderc

[input]
game_binding = /input/game.input_bindingc

[display]
width = 720
height = 1280
high_dpi = 1

[script]
shared_state = 1

[html5]
heap_size = 192
