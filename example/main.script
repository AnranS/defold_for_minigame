-- Demo for the minigame module. It runs unchanged in the editor, in a
-- browser, and in a mini game; outside a mini game the SDK calls report
-- "not running in a mini game" instead of failing.

local minigame = require "minigame.minigame"

local SAVE_FILE = sys.get_save_file("defold_mini_game_demo", "progress")

local function set_text(text)
    label.set_text("#label", text)
end

local function describe(self)
    local where = minigame.platform() or "no mini-game host"
    return ("Defold Mini Game demo\n%s\ntaps: %d\n%s"):format(where, self.taps, self.status)
end

function init(self)
    msg.post(".", "acquire_input_focus")
    local saved = sys.load(SAVE_FILE)
    self.taps = saved.taps or 0
    self.status = "tap to count"

    if minigame.is_available() then
        local info = minigame.info()
        self.status = ("save: %s, engine audio: %s"):format(info.persistence, tostring(info.engineAudio))
        minigame.set_share_content({ title = "Defold Mini Game demo" })
        minigame.on_hide(function()
            sys.save(SAVE_FILE, { taps = self.taps })
        end)
        minigame.login(function(code, err)
            self.status = err and ("login failed: " .. err) or "logged in"
            set_text(describe(self))
        end)
    end
    set_text(describe(self))
end

function on_input(self, action_id, action)
    if action_id == hash("touch") and action.pressed then
        self.taps = self.taps + 1
        sys.save(SAVE_FILE, { taps = self.taps })
        if self.taps % 10 == 0 then
            minigame.vibrate_short("light")
            minigame.show_toast(self.taps .. " taps")
        end
        set_text(describe(self))
    end
end
