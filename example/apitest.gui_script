-- The API test app: every function of the minigame module as a button.
--
-- Tap a button to run one test; its colour and the line under its section
-- show the result. "Run all" runs the tests that need no tap from the player.
-- Every result is also printed as "[apitest] <status> <id> <detail>", and a
-- run of all tests ends with "[apitest] done pass=.. fail=.. skip=.. info=..",
-- so a run can be checked from the host's console.
--
-- The app starts "Run all" by itself when the host storage holds
-- apitest.autorun = "1"; scripts/devtools_probe.mjs sets that for unattended
-- runs in a developer tool.

local minigame = require "minigame.minigame"
local apitest = require "example.apitest"

local WIDTH, HEIGHT = 720, 1280
local MARGIN = 24
local HEADER = 214
local FOOTER = 138
local GAP = 12
local COLUMNS = 3
local BUTTON_WIDTH = (WIDTH - MARGIN * 2 - GAP * (COLUMNS - 1)) / COLUMNS
local BUTTON_HEIGHT = 58
local TAP_SLOP = 14

local COLOR = {
    background = vmath.vector4(0.027, 0.039, 0.059, 1),
    panel = vmath.vector4(0.055, 0.078, 0.114, 1),
    button = vmath.vector4(0.102, 0.149, 0.220, 1),
    manual = vmath.vector4(0.165, 0.137, 0.224, 1),
    running = vmath.vector4(0.757, 0.557, 0.141, 1),
    pass = vmath.vector4(0.027, 0.553, 0.306, 1),
    fail = vmath.vector4(0.757, 0.161, 0.224, 1),
    skip = vmath.vector4(0.290, 0.329, 0.388, 1),
    info = vmath.vector4(0.153, 0.420, 0.710, 1),
    text = vmath.vector4(0.961, 0.969, 0.984, 1),
    muted = vmath.vector4(0.612, 0.663, 0.733, 1),
    accent = vmath.vector4(0.357, 0.706, 1, 1),
}

local SAVE_FILE = sys.get_save_file("defold_mini_game_api_tests", "state")

-- ── nodes ───────────────────────────────────────────────────────────

local function new_box(parent, x, y, width, height, color)
    local node = gui.new_box_node(vmath.vector3(x, y, 0), vmath.vector3(width, height, 0))
    gui.set_pivot(node, gui.PIVOT_NW)
    gui.set_color(node, color)
    if parent then
        gui.set_parent(node, parent)
    end
    return node
end

--- width is the wrapping width in layout units; nil keeps the text on one line.
local function new_text(parent, x, y, value, color, scale, width, pivot)
    local node = gui.new_text_node(vmath.vector3(x, y, 0), value)
    gui.set_font(node, "apitest")
    gui.set_pivot(node, pivot or gui.PIVOT_NW)
    gui.set_color(node, color)
    gui.set_scale(node, vmath.vector3(scale, scale, 1))
    if width then
        gui.set_size(node, vmath.vector3(width / scale, 40, 0))
        gui.set_line_break(node, true)
    end
    if parent then
        gui.set_parent(node, parent)
    end
    return node
end

local function new_button(parent, x, y, width, height, label, color)
    local node = new_box(parent, x, y, width, height, color)
    new_text(node, width / 2, -height / 2, label, COLOR.text, 0.62, width - 12, gui.PIVOT_CENTER)
    return node
end

-- ── results ─────────────────────────────────────────────────────────

--- A release build drops print(), so results also go to the host's console.
local function announce(line)
    print(line)
    minigame.log(line)
end

local function log(self, line)
    table.insert(self.log, 1, line)
    while #self.log > 3 do
        table.remove(self.log)
    end
    gui.set_text(self.log_node, table.concat(self.log, "\n"))
end

local function recount(self)
    local counts = { pass = 0, fail = 0, skip = 0, info = 0 }
    for _, entry in ipairs(self.entries) do
        if entry.status then
            counts[entry.status] = counts[entry.status] + 1
        end
    end
    gui.set_text(self.counts_node, ("pass %d   fail %d   skip %d   info %d   of %d"):format(
        counts.pass, counts.fail, counts.skip, counts.info, #self.entries))
    return counts
end

local function advance(self)
    if not self.queue then
        return
    end
    local entry = table.remove(self.queue, 1)
    if entry then
        self.run(self, entry, true)
        return
    end
    self.queue = nil
    local counts = recount(self)
    announce(("[apitest] done pass=%d fail=%d skip=%d info=%d total=%d"):format(
        counts.pass, counts.fail, counts.skip, counts.info, #self.entries))
    log(self, ("Run all finished: %d passed, %d failed"):format(counts.pass, counts.fail))
end

local function report(self, entry, status, detail)
    detail = tostring(detail or "")
    entry.status = status
    gui.set_color(entry.button, COLOR[status])
    gui.set_text(entry.result, ("%s: %s  %s"):format(entry.test.label, status, detail))
    gui.set_color(entry.result, status == "fail" and COLOR.fail or COLOR.muted)
    announce(("[apitest] %s %s %s"):format(status, entry.test.id, detail))
    log(self, ("%s %s %s"):format(status, entry.test.id, detail))
    recount(self)
end

--- queued is true when "Run all" started the test; the next one waits for its first answer.
local function run(self, entry, queued)
    entry.run_number = (entry.run_number or 0) + 1
    local run_number = entry.run_number
    local answered = false
    entry.status = nil
    gui.set_color(entry.button, COLOR.running)

    local function done(status, detail)
        if run_number ~= entry.run_number then
            return -- an answer to an earlier tap
        end
        local first = not answered
        answered = true
        local shown, err = pcall(report, self, entry, status, detail)
        if not shown then
            -- Say so in the host console and keep going: one result that cannot be drawn must not stop the run.
            announce(("[apitest] fail %s the result could not be shown: %s"):format(entry.test.id, tostring(err)))
        end
        if first and self.current == entry then
            self.current = nil
            advance(self)
        end
    end

    if queued then
        self.current = entry
    end
    local ok, err = pcall(entry.test.run, done, self.env)
    if not ok then
        done("fail", "the test raised: " .. tostring(err))
    end
    local limit = entry.test.timeout or (entry.test.auto and 6 or 60)
    timer.delay(limit, false, function()
        if not answered then
            done("fail", ("no answer within %d s"):format(limit))
        end
    end)
end

local function run_all(self)
    if self.queue then
        return
    end
    self.queue = {}
    for _, entry in ipairs(self.entries) do
        if entry.test.auto then
            self.queue[#self.queue + 1] = entry
        end
    end
    announce(("[apitest] start tests=%d platform=%s"):format(#self.queue, tostring(minigame.platform())))
    log(self, ("Running %d tests"):format(#self.queue))
    advance(self)
end

-- ── tests that need the engine ──────────────────────────────────────

--- Answers that come back from /example/apitest.script, by test id.
local function ask_driver(self, message_id, id, done, message)
    self.waiting[id] = done
    message = message or {}
    message.id = id
    msg.post("#driver", message_id, message)
end

local function engine_section(self)
    return {
        title = "Engine",
        hint = "Defold itself, through the adapter",
        tests = {
            { id = "engine.save_load", label = "sys.save", auto = true, run = function(done)
                local stamp = os.time()
                local state = sys.load(SAVE_FILE)
                state.stamp = stamp
                if not sys.save(SAVE_FILE, state) then
                    done("fail", "sys.save returned false")
                    return
                end
                local loaded = sys.load(SAVE_FILE)
                done(loaded.stamp == stamp and "pass" or "fail", "saved and read back from " .. tostring(minigame.info() and minigame.info().persistence))
            end },
            { id = "engine.launches", label = "launch count", auto = true, run = function(done)
                done("pass", ("launch %d: the count is kept by sys.save across restarts"):format(self.launches))
            end },
            { id = "engine.sound", label = "sound", auto = true, timeout = 8, run = function(done)
                if not minigame.has_engine_audio() then
                    done("skip", "the engine mixer is off on this host; use inner_audio")
                    return
                end
                ask_driver(self, "play_tone", "engine.sound", done)
            end },
            { id = "engine.two_states", label = "two Lua states", auto = true, run = function(done)
                ask_driver(self, "sdk_from_game_object", "engine.two_states", done, { gui_client = tostring(minigame.info().client) })
            end },
            { id = "engine.sys_info", label = "sys info", auto = true, run = function(done)
                local info = sys.get_sys_info()
                local engine = sys.get_engine_info()
                done("pass", ("Defold %s, %s, %s"):format(tostring(engine.version), tostring(info.system_name), tostring(info.device_model)))
            end },
            { id = "engine.window", label = "window", auto = true, run = function(done)
                local width, height = window.get_size()
                done((width > 0 and height > 0) and "pass" or "fail", ("%dx%d pixels"):format(width, height))
            end },
            { id = "engine.http", label = "http.request", timeout = 20, run = function(done)
                http.request("https://defold.com/", "GET", function(_, _, response)
                    if response.status >= 200 and response.status < 400 then
                        done("pass", ("status %d, %d bytes"):format(response.status, #(response.response or "")))
                    else
                        done("fail", ("status %d"):format(response.status))
                    end
                end)
            end },
            { id = "engine.keyboard", label = "keyboard", run = function(done)
                self.typed = ""
                self.typing = done
                gui.show_keyboard(gui.KEYBOARD_TYPE_DEFAULT, false)
                done("info", "type something, then press return")
            end },
        },
    }
end

-- ── layout ──────────────────────────────────────────────────────────

local function build(self)
    new_box(nil, WIDTH / 2 - 2000, HEIGHT / 2 + 3000, 4000, 6000, COLOR.background)

    -- The scrolling list is clipped to the space between header and footer.
    self.viewport = new_box(nil, 0, HEIGHT - HEADER, WIDTH, HEIGHT - HEADER - FOOTER, COLOR.background)
    gui.set_clipping_mode(self.viewport, gui.CLIPPING_MODE_STENCIL)
    gui.set_clipping_visible(self.viewport, false)
    self.content = new_box(self.viewport, 0, 0, 1, 1, vmath.vector4(0, 0, 0, 0))

    local sections = {}
    for _, section in ipairs(apitest.sections) do
        sections[#sections + 1] = section
    end
    sections[#sections + 1] = engine_section(self)

    local y = 14
    for _, section in ipairs(sections) do
        new_text(self.content, MARGIN, -y, section.title, COLOR.accent, 0.8)
        if section.hint then
            new_text(self.content, WIDTH - MARGIN, -y - 4, section.hint, COLOR.muted, 0.5, nil, gui.PIVOT_NE)
        end
        y = y + 38
        local result = new_text(self.content, 0, 0, "not run yet", COLOR.muted, 0.52, WIDTH - MARGIN * 2)
        for index, test in ipairs(section.tests) do
            local column = (index - 1) % COLUMNS
            local row = math.floor((index - 1) / COLUMNS)
            local button = new_button(self.content, MARGIN + column * (BUTTON_WIDTH + GAP), -(y + row * (BUTTON_HEIGHT + GAP)),
                BUTTON_WIDTH, BUTTON_HEIGHT, test.label, test.auto and COLOR.button or COLOR.manual)
            self.entries[#self.entries + 1] = { test = test, button = button, result = result }
        end
        y = y + math.ceil(#section.tests / COLUMNS) * (BUTTON_HEIGHT + GAP)
        gui.set_position(result, vmath.vector3(MARGIN, -y, 0))
        y = y + 58
    end
    self.content_height = y + 20

    -- Header and footer are created last, so they draw over the list.
    new_box(nil, 0, HEIGHT, WIDTH, HEADER, COLOR.panel)
    new_text(nil, MARGIN, HEIGHT - 20, "Defold Mini Game API tests", COLOR.text, 1)
    local info = minigame.info()
    local host = info and ("%s | tool %s | bridge ABI %s | saves in %s"):format(
        tostring(info.platform), tostring(info.toolVersion), tostring(info.abi), tostring(info.persistence))
        or "not running in a mini game: every call reports that"
    new_text(nil, MARGIN, HEIGHT - 62, host, COLOR.muted, 0.52, WIDTH - MARGIN * 2)
    self.counts_node = new_text(nil, MARGIN, HEIGHT - 96, "", COLOR.text, 0.6)
    self.run_all_button = new_button(nil, MARGIN, HEIGHT - 138, 330, 58, "Run all", COLOR.info)
    new_text(nil, MARGIN + 346, HEIGHT - 146, "purple buttons need a tap,\nor leave the game", COLOR.muted, 0.48)

    new_box(nil, 0, FOOTER, WIDTH, FOOTER, COLOR.panel)
    self.log_node = new_text(nil, MARGIN, FOOTER - 14, "Tap a button to run a test.", COLOR.muted, 0.5, WIDTH - MARGIN * 2)
    recount(self)
end

local function scroll_to(self, offset)
    local limit = math.max(0, self.content_height - (HEIGHT - HEADER - FOOTER))
    self.scroll = math.max(0, math.min(limit, offset))
    gui.set_position(self.content, vmath.vector3(0, self.scroll, 0))
end

-- ── lifecycle ───────────────────────────────────────────────────────

function init(self)
    msg.post(".", "acquire_input_focus")
    self.entries = {}
    self.log = {}
    self.waiting = {}
    self.scroll = 0
    self.run = run
    self.env = {
        delay = function(seconds, fn)
            timer.delay(seconds, false, fn)
        end,
    }

    local state = sys.load(SAVE_FILE)
    self.launches = (state.launches or 0) + 1
    state.launches = self.launches
    sys.save(SAVE_FILE, state)

    minigame.init()
    build(self)

    if minigame.storage_get("apitest.autorun", "") == "1" then
        timer.delay(0.5, false, function()
            run_all(self)
        end)
    end
end

function update(self, dt)
    -- A GUI script has a Lua state of its own, so it polls for its own
    -- results; /minigame/minigame.go does the same for game object scripts.
    minigame.update()
end

function on_message(self, message_id, message)
    if message_id == hash("driver_result") then
        local done = self.waiting[message.id]
        if done then
            done(message.status, message.detail)
        end
    end
end

function on_input(self, action_id, action)
    if action_id == hash("text") and self.typing then
        self.typed = self.typed .. action.text
        self.typing("info", "typed: " .. self.typed)
        return true
    elseif action_id == hash("backspace") and self.typing and action.pressed then
        self.typed = self.typed:sub(1, -2)
        self.typing("info", "typed: " .. self.typed)
        return true
    elseif action_id == hash("enter") and self.typing and action.pressed then
        local done = self.typing
        self.typing = nil
        gui.hide_keyboard()
        done(#self.typed > 0 and "pass" or "info", "typed: " .. self.typed)
        return true
    end

    if action_id ~= hash("touch") then
        return false
    end
    if action.pressed then
        self.drag = { y = action.y, moved = 0 }
    elseif action.released then
        local drag = self.drag
        self.drag = nil
        if drag and drag.moved <= TAP_SLOP then
            if gui.pick_node(self.run_all_button, action.x, action.y) then
                run_all(self)
            elseif gui.pick_node(self.viewport, action.x, action.y) then
                for _, entry in ipairs(self.entries) do
                    if gui.pick_node(entry.button, action.x, action.y) then
                        run(self, entry)
                        break
                    end
                end
            end
        end
    elseif self.drag then
        local delta = action.y - self.drag.y
        self.drag.y = action.y
        self.drag.moved = self.drag.moved + math.abs(delta)
        scroll_to(self, self.scroll + delta)
    end
    return true
end
